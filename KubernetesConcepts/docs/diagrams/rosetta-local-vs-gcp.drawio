        <mxCell id="m1" value="1:1 CIDR parity" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="l1" target="g1" parent="1">
