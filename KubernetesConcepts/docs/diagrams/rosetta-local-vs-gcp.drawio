        <mxCell id="m3" value="same 4-door model" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="l3" target="g3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
