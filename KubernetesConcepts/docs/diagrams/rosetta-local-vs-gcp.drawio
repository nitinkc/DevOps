        <mxCell id="m5" value="same 4 ingress breaks" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="l5" target="g5" parent="1">
