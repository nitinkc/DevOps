        <mxCell id="l7" value="FluxCD · clusters/local&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;10-controllers → 20-configs → 30-apps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="local">
