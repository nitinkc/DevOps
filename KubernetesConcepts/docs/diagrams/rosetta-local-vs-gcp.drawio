<mxfile host="Electron">
  <diagram id="rosetta" name="Local-vs-GCP">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Local Lab ⇄ GCP — same architecture, same failure modes, different managed objects" style="text;html=1;fillColor=#ffffff;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="800" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;LOCAL — Docker + Minikube&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;spacingTop=4;fontSize=12;container=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="560" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="gcp" value="&lt;b&gt;GCP — Terraform + GKE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;spacingTop=4;fontSize=12;container=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="560" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="Docker bridges&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;acme-main 10.10.0.0/24 · acme-ops 10.10.1.0/28&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="local">
          <mxGeometry x="15" y="45" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="VPC acme-main&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;subnets gke-main / ops / proxy-only · secondary ranges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="gcp">
          <mxGeometry x="15" y="45" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="vpc-router container&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ip_forward + iptables FORWARD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="local">
          <mxGeometry x="15" y="125" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="VPC route table + google_compute_firewall&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ master→webhook rules (15017/8443)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="gcp">
          <mxGeometry x="15" y="125" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="ip route del default + node label allowed-open-nat&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ /32 route + local registry 10.10.0.200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="local">
          <mxGeometry x="15" y="205" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="delete_default_routes + 4 doors&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PGA 199.36.153.8/30 · /32 VIPs · Cloud NAT + tags · VPN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="gcp">
          <mxGeometry x="15" y="205" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="Cilium via Helm (ipam.mode=kubernetes)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ Hubble CLI · VXLAN overlay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="local">
          <mxGeometry x="15" y="285" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="GKE Dataplane V2 (ADVANCED_DATAPATH)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;VPC-native alias IPs — same eBPF engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="gcp">
