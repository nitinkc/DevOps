        <mxCell id="m6" value="same 3 log paths" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="l6" target="g6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="100% same manifests" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="l7" target="g7" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="new" value="&lt;b&gt;Only 5 things are genuinely new on GCP&lt;/b&gt;&lt;br/&gt;1 · GitLab OIDC → WIF (CEL attribute mapping)  2 · PGA + private DNS zones (Door 1)  3 · master→node webhook firewall (15017)&lt;br/&gt;4 · Workload Identity metadata server egress hole (169.254.169.252:988)  5 · proxy-only subnet + LB health-check ranges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
