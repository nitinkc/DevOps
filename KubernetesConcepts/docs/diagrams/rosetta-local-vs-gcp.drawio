        <mxCell id="m4" value="identical eBPF" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="l4" target="g4" parent="1">
