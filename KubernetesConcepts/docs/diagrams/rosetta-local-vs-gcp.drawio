        </mxCell>
        <mxCell id="g5" value="Gateway gke-l7-rilb&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;proxy-only-subnet 10.10.254.0/23 + health-check ranges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="gcp">
          <mxGeometry x="15" y="365" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l6" value="observability/log-aggregator&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Fluent Bit forward → stdout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="local">
