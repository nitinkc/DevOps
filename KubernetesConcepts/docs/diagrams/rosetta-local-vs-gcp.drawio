        <mxCell id="g6" value="central-app-logs bucket&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Log Router sink filter + _Default exclusion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="gcp">
          <mxGeometry x="15" y="445" width="530" height="60" as="geometry"/>
