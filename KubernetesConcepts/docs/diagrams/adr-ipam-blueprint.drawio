<mxfile host="Electron">
  <diagram id="ipam" name="IPAM-Blueprint">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Master IPAM blueprint — four address classes, decided before any code" style="text;html=1;fillColor=#ffffff;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="800" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;1 · Primary routable — RFC 1918&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="400" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="c1a" value="&lt;b&gt;acme-main&lt;/b&gt; · 10.10.0.0/24&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;254 IPs — nodes, MetalLB VIPs, registry&lt;br/&gt;GCP: gke-main subnet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c1">
          <mxGeometry x="20" y="50" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c1b" value="&lt;b&gt;acme-ops&lt;/b&gt; · 10.10.1.0/28&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;14 IPs — bastion / probe&lt;br/&gt;GCP: ops subnet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c1">
          <mxGeometry x="20" y="118" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c1c" value="&lt;b&gt;GKE master&lt;/b&gt; · 10.10.250.0/28&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;14 IPs — mandatory /28, VPC-peered control plane&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c1">
          <mxGeometry x="20" y="186" width="360" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;2 · Cluster secondary ranges&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="400" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="c2a" value="&lt;b&gt;pods&lt;/b&gt; · 10.20.0.0/20&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4,096 IPs — /24 per node (16 nodes max)&lt;br/&gt;GKE max_pods=64 → /25 → 32 nodes max&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c2">
          <mxGeometry x="20" y="50" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c2b" value="&lt;b&gt;services&lt;/b&gt; · 10.30.0.0/24&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;254 virtual ClusterIPs — DNAT only,&lt;br/&gt;never routable outside the cluster&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c2">
          <mxGeometry x="20" y="142" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;3 · Google-managed proxy space&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="60" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c3a" value="&lt;b&gt;proxy-only-subnet&lt;/b&gt; · 10.10.254.0/23&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;512 IPs — REGIONAL_MANAGED_PROXY&lt;br/&gt;Envoy fleet for gke-l7-rilb internal ALB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c3">
          <mxGeometry x="20" y="40" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;4 · Private Services Access — RFC 6598&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="190" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c4a" value="&lt;b&gt;PSA&lt;/b&gt; · 100.64.0.0/20&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4,096 IPs — Cloud SQL / Memorystore&lt;br/&gt;VPC peering — NON-TRANSITIVE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c4">
          <mxGeometry x="20" y="40" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Three golden rules&lt;/b&gt;&lt;br/&gt;· Node count is often capped by the POD CIDR (/20 ÷ /24 = 16 nodes), not the node subnet&lt;br/&gt;· Overlap is silent until you connect networks (peering/VPN/NCC) — then it breaks catastrophically&lt;br/&gt;· Never burn 10.x on managed DBs — PSA uses 100.64.0.0/10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="840" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
