<mxfile host="Electron">
  <diagram id="gauntlet" name="Lab08-Ingress-Gauntlet">
    <mxGraphModel dx="1400" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 08 — North-South ingress gauntlet: four guards, four distinct failure signatures" style="text;html=1;fillColor=#ffffff;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="860" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;probe&lt;/b&gt; client&lt;br/&gt;10.10.1.3&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;acme-ops subnet&lt;br/&gt;(GCP: ops VM via IAP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;#1 · vpc-router firewall&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;iptables FORWARD&lt;br/&gt;need: 10.10.1.3 → VIP:80&lt;br/&gt;&lt;font color=&quot;#b85450&quot;&gt;symptom: timeout 000&lt;/font&gt;&lt;br/&gt;GCP: VPC firewall&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="130" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;#2 · LB + Ingress NetPol&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;payments-lb VIP 10.10.0.240&lt;br/&gt;DNAT :80 → pod :8080&lt;br/&gt;need: ipBlock 10.10.1.0/28 :8080&lt;br/&gt;&lt;font color=&quot;#b85450&quot;&gt;symptom: timeout + Hubble DROPPED&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;#3 · STRICT mTLS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;LB speaks plaintext — no cert&lt;br/&gt;fix: portLevelMtls 8080 PERMISSIVE&lt;br/&gt;&lt;font color=&quot;#b85450&quot;&gt;symptom: conn reset by peer&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;#4 · AuthorizationPolicy&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;plaintext has no SPIFFE principal&lt;br/&gt;fix: ALLOW ipBlocks 10.10.1.0/28&lt;br/&gt;+ externalTrafficPolicy: Local&lt;br/&gt;&lt;font color=&quot;#b85450&quot;&gt;symptom: HTTP 403 RBAC denied&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="990" y="120" width="210" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;payments&lt;/b&gt;&lt;br/&gt;pod :8080&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;HTTP 200 OK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="140" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" source="probe" target="g1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" source="g1" target="g2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" source="g2" target="g3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;" edge="1" source="g3" target="g4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=3;" edge="1" source="g4" target="app" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="snat" value="&lt;b&gt;Why externalTrafficPolicy: Local is mandatory&lt;/b&gt;&lt;br/&gt;Default policy &amp;quot;Cluster&amp;quot; SNATs the packet to the receiving node's IP — the pod then sees&lt;br/&gt;10.10.0.x, never 10.10.1.3. IP-based NetworkPolicy/AuthorizationPolicy + audit logs all break.&lt;br/&gt;&amp;quot;Local&amp;quot; preserves the real client source IP end-to-end." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="230" y="300" width="700" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="gcp" value="&lt;b&gt;GCP twin (P9)&lt;/b&gt;&lt;br/&gt;Gateway gke-l7-rilb lives in proxy-only-subnet 10.10.254.0/23 — same four guards apply:&lt;br/&gt;VPC firewall (proxy→nodes + health checks 130.211/22, 35.191/16) → NetPol → mTLS → AuthZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="170" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
