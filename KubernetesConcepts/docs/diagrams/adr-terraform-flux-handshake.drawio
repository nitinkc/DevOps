<mxfile host="Electron">
  <diagram id="handshake" name="ADR-Terraform-Flux">
    <mxGraphModel dx="1400" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ADR-05 — Ownership boundary: Terraform owns the cloud, FluxCD owns the cluster" style="text;html=1;fillColor=#ffffff;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="800" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="tf" value="&lt;b&gt;Terraform — GCP / underlay objects&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="320" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="tf1" value="VPC · subnets · routes&lt;br/&gt;NAT · firewall · DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="tf">
          <mxGeometry x="20" y="50" width="280" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="tf2" value="GKE cluster + node pools&lt;br/&gt;Artifact Registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="tf">
          <mxGeometry x="20" y="122" width="280" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="tf3" value="GSAs + WI bindings&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;orders-app@proj → [dom-orders/orders]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="tf">
          <mxGeometry x="20" y="194" width="280" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="hs" value="&lt;b&gt;Deterministic name contract&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;namespace dom-orders&lt;br/&gt;KSA orders&lt;br/&gt;annotation: iam.gke.io/&lt;br/&gt;gcp-service-account&lt;br/&gt;&lt;b&gt;zero API coupling&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="220" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="fx" value="&lt;b&gt;FluxCD — in-cluster state&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="320" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="fx1" value="10-infra-controllers&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;istiod · metallb · CRDs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="fx">
          <mxGeometry x="20" y="50" width="280" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="fx2" value="20-infra-configs&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;namespaces · NetPol · mTLS · pools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="fx">
          <mxGeometry x="20" y="122" width="280" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="fx3" value="30-apps&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;HelmReleases for 3 domains&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="fx">
          <mxGeometry x="20" y="194" width="280" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;fontSize=9;" edge="1" source="tf" target="hs" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;fontSize=9;" edge="1" source="hs" target="fx" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Why the hard boundary&lt;/b&gt;&lt;br/&gt;· GitLab CI never needs access to the private GKE endpoint — Flux pulls Git → cluster from inside (Door 3)&lt;br/&gt;· Kubernetes CRDs inside Terraform state wedged plans/destroys&lt;br/&gt;· Names, not lookups: orders-app@&amp;lt;proj&amp;gt;.iam.gserviceaccount.com is computable by both sides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1000" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
