<mxfile host="Electron">
  <diagram id="doors" name="Lab04-Four-Doors">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 04 — Default route deleted: every outbound flow must use one of the four doors" style="text;html=1;fillColor=#ffffff;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="800" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="cluster" value="&lt;b&gt;Minikube worker nodes&lt;/b&gt;  (default route 0.0.0.0/0 DELETED — GCP: delete_default_routes_on_create)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="320" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;acme-m02&lt;/b&gt; · 10.10.0.11&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;labels: pool=main&lt;br/&gt;NO default route — locked down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="cluster">
          <mxGeometry x="25" y="60" width="270" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;acme-m03&lt;/b&gt; · 10.10.0.12&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;labels: pool=main, &lt;b&gt;allowed-open-nat=true&lt;/b&gt;&lt;br/&gt;has default route (Door 3 open)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="cluster">
          <mxGeometry x="25" y="160" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="snat" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Pods inherit the node route table:&lt;/b&gt;&lt;br/&gt;pod src 10.20.1.x → SNAT/masq to node IP&lt;br/&gt;→ per-POD egress control needs&lt;br/&gt;NetworkPolicy / Istio, not routes or tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="cluster">
          <mxGeometry x="25" y="280" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Door 1 · Private services / registry&lt;/b&gt;&lt;br/&gt;Local: 10.10.0.200:5000 (same subnet)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GCP: PGA + route 199.36.153.8/30 + private DNS&lt;br/&gt;→ private.googleapis.com / pkg.dev / gcr.io&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Door 2 · /32 partner VIP allow-list&lt;/b&gt;&lt;br/&gt;Local: ip route add $EX_IP/32 via 10.10.0.1&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GCP: google_compute_route.public_services prio 900&lt;br/&gt;longest-prefix match beats deleted default&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Door 3 · Tag-gated Cloud NAT&lt;/b&gt;&lt;br/&gt;Local: default route only on acme-m03&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GCP: route 0.0.0.0/0 prio 999 tagged &amp;quot;allowed-open-nat&amp;quot;&lt;br/&gt;+ Cloud NAT with 2 static IPs (MANUAL_ONLY)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;Door 4 · Hybrid / on-prem route&lt;/b&gt;&lt;br/&gt;Local: 10.10.1.0/28 via 10.10.0.250 (vpc-router)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GCP: HA VPN + Cloud Router BGP → onprem-sim&lt;br/&gt;unaffected by the deleted internet route&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="390" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e21" value="registry ✔" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" source="n2" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="/32 only ✔" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" source="n2" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e24" value="ops subnet ✔" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" source="n2" target="d4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="untagged — NO route ✗" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="n2" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e33" value="tagged → 0.0.0.0/0 ✔" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" source="n3" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="results" value="&lt;b&gt;Evidence table&lt;/b&gt; — m02: registry ✔ · /32 VIP ✔ · internet ✗ · ops ✔&lt;br/&gt;m03: everything ✔ (Door 3)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DNS still resolves after route deletion — resolution is out-of-band (CoreDNS → Docker resolver), TCP data path dies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="340" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
