<mxfile host="Electron">
  <diagram id="flux" name="Lab09-Flux-Tiers">
    <mxGraphModel dx="1400" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 09 — FluxCD GitOps: explicit dependency tiers keep cold rebuilds green" style="text;html=1;fillColor=#ffffff;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="800" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t0" value="&lt;b&gt;0 · Pre-GitOps bootstrap&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Minikube nodes + Cilium CNI&lt;br/&gt;must exist BEFORE Flux pods can run&lt;br/&gt;(GCP: Dataplane V2 = cluster setting)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;1 · 10-infra-controllers&lt;/b&gt;  wait: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="300" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="t1a" value="HelmRepositories&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;istio · metallb&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="t1">
          <mxGeometry x="20" y="50" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t1b" value="istio-base → istiod&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CRDs, then webhook must be READY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="t1">
          <mxGeometry x="20" y="112" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t1c" value="metallb&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;IPAddressPool / L2Advertisement CRDs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="t1">
          <mxGeometry x="20" y="174" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;2 · 20-infra-configs&lt;/b&gt;  dependsOn: controllers + wait: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="300" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="t2a" value="Namespaces WITH labels&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;istio-injection=enabled —&lt;br/&gt;must exist before first pod!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="t2">
          <mxGeometry x="20" y="50" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="t2b" value="NetworkPolicies&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;default-deny + explicit holes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;" vertex="1" parent="t2">
          <mxGeometry x="20" y="122" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t2c" value="PeerAuth STRICT + AuthZ&lt;br/&gt;MetalLB IPAddressPool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="t2">
          <mxGeometry x="20" y="184" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;3 · 30-apps&lt;/b&gt;  dependsOn: configs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;container=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="60" width="300" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="t3a" value="log-aggregator&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;observability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="t3">
          <mxGeometry x="20" y="50" width="260" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="t3b" value="HelmReleases&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;orders · payments · inventory&lt;br/&gt;pods start WITH sidecars into&lt;br/&gt;a fully-secured namespace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="t3">
          <mxGeometry x="20" y="112" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e01" value="flux bootstrap" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;fontSize=9;" edge="1" source="t0" target="t1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="dependsOn" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=9;" edge="1" source="t1" target="t2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="dependsOn" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=9;" edge="1" source="t2" target="t3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fails" value="&lt;b&gt;What breaks without ordering&lt;/b&gt;&lt;br/&gt;· configs before controllers → &amp;quot;no matches for kind IPAddressPool / PeerAuthentication&amp;quot; (CRD not installed)&lt;br/&gt;· apps before labeled namespaces → pods start with 1/1 containers — no sidecar, no mTLS&lt;br/&gt;· wait:false on controllers → dependants run while istiod webhook is still down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="1020" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
